# Copy this file to .env and fill in real values. .env is gitignored.

# Required: Google Gemini API key for /api/extract, /api/sketch-to-svg, /api/extract-images.
GEMINI_API_KEY=your-gemini-key-here

# Optional: restrict allowed CORS origin for the Express server.
# Defaults to http://localhost:3000 (the Vite dev server) if unset.
# CORS_ORIGIN=http://localhost:3000

# Optional: Gmail SMTP for /api/email. Without these, /api/email is mocked.
# Use a Gmail App Password, not your account password.
SMTP_USER=
SMTP_PASS=

# Optional: Google Drive integration for /api/save-drive. Without all three set,
# the route stays in mock mode. Run `npm run bootstrap-drive` once after filling
# in CLIENT_ID / CLIENT_SECRET — that flow populates GOOGLE_REFRESH_TOKEN.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (type: "Desktop app"). Required scope: drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
